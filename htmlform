<script>
// Hàm chuyển đổi tab hồ sơ cá cược
function switchProfileTab(element, tabId) {
    // Xóa active từ tất cả tabs
    document.querySelectorAll('.profile-tab').forEach(tab => {
        tab.classList.remove('active');
    });
    
    // Xóa active từ tất cả content
    document.querySelectorAll('.profile-content').forEach(content => {
        content.classList.remove('active');
    });
    
    // Thêm active vào tab được click
    element.classList.add('active');
    
    // Hiển thị content tương ứng
    document.getElementById(tabId).classList.add('active');
}

// Khởi tạo bảng số
function initNumbers() {
    const containers = [
        { id: 'de-chuc', count: 10 },
        { id: 'de-donvi', count: 10 },
        { id: 'dd-chuc', count: 10 },
        { id: 'dd-donvi', count: 10 },
        { id: '3c-chuc', count: 10 },
        { id: '3c-donvi', count: 10 },
        { id: 'xienNumbers', count: 100 }
    ];

    containers.forEach(container => {
        const el = document.getElementById(container.id);
        if (el) {
            for (let i = 0; i < container.count; i++) {
                const span = document.createElement('span');
                span.textContent = i.toString().padStart(2, '0');
                span.onclick = function() {
                    this.classList.toggle('active');
                };
                el.appendChild(span);
            }
        }
    });
}

// Hàm chọn hàng
function selectRow(containerId, type) {
    const container = document.getElementById(containerId);
    const spans = container.querySelectorAll('span');
    
    spans.forEach((span, index) => {
        let shouldSelect = false;
        const num = parseInt(span.textContent);
        
        if (type === 'all') shouldSelect = true;
        else if (type === 'tai' && num > 4) shouldSelect = true;
        else if (type === 'xiu' && num < 5) shouldSelect = true;
        else if (type === 'le' && num % 2 === 1) shouldSelect = true;
        else if (type === 'chan' && num % 2 === 0) shouldSelect = true;
        
        if (shouldSelect) span.classList.add('active');
    });
}

// Hàm xóa hàng
function clearRow(containerId) {
    const container = document.getElementById(containerId);
    container.querySelectorAll('span').forEach(span => {
        span.classList.remove('active');
    });
}

// Khởi tạo khi trang load
document.addEventListener('DOMContentLoaded', initNumbers);
</script>

