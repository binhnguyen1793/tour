.deposit-waiting-note{
  display:flex;
  align-items:flex-start;
  gap:9px;

  max-width:350px;
  margin:8px auto 12px;
  padding:10px 11px;

  border:1px solid #ffc9c9;
  border-radius:9px;

  background:#fff2f2;
  color:#c23d45;

  font-size:11px;
  line-height:1.5;
  text-align:left;
}

.deposit-waiting-note span{
  flex:0 0 auto;
  font-size:16px;
}

.deposit-waiting-note p{
  margin:0;
}

.deposit-waiting-note b{
  color:#b42e39;
}

.deposit-waiting-note strong{
  color:#d51f2f;
  font-weight:800;
}
