/* =========================================================
   V30 - DESKTOP AUTH + ACCOUNT DROPDOWN FINAL
   MOBILE KHÔNG BỊ ẢNH HƯỞNG
   ========================================================= */

@media (min-width:761px){

  /* =======================================================
     1. POPUP ĐĂNG KÝ / ĐĂNG NHẬP DESKTOP
     ======================================================= */

  #authModal{
    position:fixed !important;
    inset:0 !important;

    width:100vw !important;
    height:100vh !important;
    min-width:0 !important;

    display:flex !important;
    align-items:center !important;
    justify-content:center !important;

    padding:24px !important;

    overflow:auto !important;

    background:rgba(7,16,28,.66) !important;

    z-index:99999 !important;
  }

  #authModal.hidden{
    display:none !important;
  }


  #authModal .auth-modal-card{
    position:relative !important;

    width:500px !important;
    max-width:calc(100vw - 60px) !important;

    max-height:calc(100vh - 40px) !important;

    margin:auto !important;
    padding:24px 26px 25px !important;

    overflow-x:hidden !important;
    overflow-y:auto !important;

    border:1px solid rgba(219,229,238,.9) !important;
    border-radius:18px !important;

    background:
      linear-gradient(
        180deg,
        #ffffff 0%,
        #fbfdff 100%
      ) !important;

    color:#35465a !important;

    box-shadow:
      0 24px 70px rgba(0,0,0,.34) !important;
  }


  /* Reset các style input/button cũ của modal */
  #authModal .auth-modal-card input,
  #authModal .auth-modal-card button{
    font-family:Arial,"Helvetica Neue",Helvetica,sans-serif !important;
  }


  /* HEADER */

  #authModal .auth-heading{
    display:flex !important;
    align-items:center !important;

    gap:12px !important;

    margin:0 0 18px !important;
    padding:0 38px 0 0 !important;
  }

  #authModal .auth-heading-icon{
    width:46px !important;
    height:46px !important;

    flex:0 0 46px !important;

    display:grid !important;
    place-items:center !important;

    margin:0 !important;

    border-radius:13px !important;

    background:
      linear-gradient(145deg,#279bf0,#0872cf) !important;

    color:#fff !important;

    font-size:20px !important;
    line-height:1 !important;

    box-shadow:
      0 7px 18px rgba(18,128,218,.20) !important;
  }

  #authModal .auth-heading.register .auth-heading-icon{
    background:
      linear-gradient(145deg,#ffb62d,#f28b16) !important;
  }

  #authModal .auth-heading > div:last-child{
    min-width:0 !important;
  }

  #authModal .auth-heading h2{
    margin:0 !important;
    padding:0 !important;

    color:#304257 !important;

    font-size:22px !important;
    line-height:27px !important;
    font-weight:700 !important;
  }

  #authModal .auth-heading p{
    margin:3px 0 0 !important;

    color:#8995a3 !important;

    font-size:11px !important;
    line-height:16px !important;
  }


  /* ƯU ĐÃI */

  #authModal .register-note{
    width:100% !important;

    display:flex !important;
    align-items:center !important;

    gap:10px !important;

    margin:0 0 17px !important;
    padding:11px 13px !important;

    border:1px solid #f8daa0 !important;
    border-radius:11px !important;

    background:
      linear-gradient(
        135deg,
        #fffaf0,
        #fff1c5
      ) !important;
  }

  #authModal .register-note > span{
    flex:0 0 auto !important;
    font-size:21px !important;
  }

  #authModal .register-note > div{
    display:flex !important;
    flex-direction:column !important;

    gap:1px !important;
  }

  #authModal .register-note b{
    color:#a66b0b !important;

    font-size:12px !important;
    line-height:17px !important;
  }

  #authModal .register-note small{
    color:#957849 !important;

    font-size:10px !important;
    line-height:14px !important;
  }


  /* FORM */

  #authModal .auth-form{
    display:flex !important;
    flex-direction:column !important;

    gap:12px !important;
  }

  #authModal .auth-field{
    width:100% !important;

    display:flex !important;
    flex-direction:column !important;

    gap:6px !important;

    margin:0 !important;
    padding:0 !important;
  }

  #authModal .auth-field > span{
    display:block !important;

    margin:0 !important;

    color:#425469 !important;

    font-size:12px !important;
    line-height:16px !important;
    font-weight:700 !important;
  }

  #authModal .auth-field > span b{
    color:#e84d5d !important;
  }

  #authModal .auth-field > span em{
    margin-left:5px !important;

    color:#a0aab5 !important;

    font-size:9px !important;
    font-style:normal !important;
    font-weight:400 !important;
  }


  /* INPUT WRAP */

  #authModal .auth-input-wrap{
    position:relative !important;

    width:100% !important;

    display:block !important;

    margin:0 !important;
  }

  #authModal .auth-input-wrap > i{
    position:absolute !important;

    left:13px !important;
    top:50% !important;

    width:20px !important;

    transform:translateY(-50%) !important;

    display:grid !important;
    place-items:center !important;

    z-index:2 !important;

    color:#71869a !important;

    font-size:14px !important;
    font-style:normal !important;

    pointer-events:none !important;
  }

  #authModal .auth-input-wrap input{
    display:block !important;

    width:100% !important;
    height:46px !important;

    margin:0 !important;
    padding:0 13px 0 43px !important;

    border:1px solid #cad6e2 !important;
    border-radius:9px !important;

    background:#fff !important;

    color:#34465a !important;

    font-size:13px !important;
    line-height:46px !important;

    outline:none !important;

    box-shadow:none !important;
  }

  #authModal .auth-input-wrap input::placeholder{
    color:#9ba5af !important;
  }

  #authModal .auth-input-wrap input:focus{
    border-color:#258fe4 !important;

    box-shadow:
      0 0 0 3px rgba(37,143,228,.10) !important;
  }

  #authModal .auth-field-help{
    display:block !important;

    margin:0 0 0 3px !important;

    color:#919ca8 !important;

    font-size:9px !important;
    line-height:13px !important;
  }


  /* CAPTCHA - input và số nằm cùng một hàng */

  #authModal .register-captcha-row{
    width:100% !important;

    display:grid !important;

    grid-template-columns:
      minmax(0,1fr) 112px !important;

    align-items:stretch !important;

    gap:9px !important;
  }

  #authModal .register-captcha-row .auth-input-wrap{
    width:auto !important;
  }

  #authModal .register-captcha-code{
    position:static !important;

    width:112px !important;
    min-width:112px !important;
    height:46px !important;

    margin:0 !important;
    padding:0 !important;

    border:1px solid #becbd7 !important;
    border-radius:9px !important;

    display:grid !important;
    place-items:center !important;

    background:
      repeating-linear-gradient(
        -15deg,
        #eef4f8,
        #eef4f8 7px,
        #dae6ef 8px,
        #eef4f8 10px
      ) !important;

    color:#334b62 !important;

    font-size:20px !important;
    line-height:46px !important;
    font-weight:900 !important;

    letter-spacing:5px !important;

    text-decoration:line-through !important;

    box-shadow:none !important;
  }


  /* CHECKBOX */

  #authModal .register-agreement{
    width:100% !important;

    display:flex !important;
    align-items:flex-start !important;

    gap:8px !important;

    margin:1px 0 0 !important;
    padding:10px 11px !important;

    border:0 !important;
    border-radius:8px !important;

    background:#f1f6fa !important;

    color:#65778a !important;

    font-size:10px !important;
    line-height:15px !important;
  }

  #authModal .register-agreement input{
    appearance:auto !important;

    width:15px !important;
    height:15px !important;

    min-width:15px !important;

    flex:0 0 15px !important;

    margin:1px 0 0 !important;
    padding:0 !important;
  }


  /* BUTTON */

  #authModal .auth-main-btn{
    width:100% !important;
    height:45px !important;
    min-height:45px !important;

    margin:2px 0 0 !important;
    padding:0 16px !important;

    border:0 !important;
    border-radius:9px !important;

    display:block !important;

    background:
      linear-gradient(
        135deg,
        #219be9,
        #0875ce
      ) !important;

    color:#fff !important;

    font-size:14px !important;
    line-height:45px !important;
    font-weight:800 !important;
    text-align:center !important;

    box-shadow:
      0 7px 17px rgba(17,119,215,.18) !important;
  }

  #authModal .auth-reset-btn{
    width:100% !important;
    height:40px !important;

    margin:0 !important;
    padding:0 !important;

    border:1px solid #d8e1ea !important;
    border-radius:9px !important;

    display:block !important;

    background:#fff !important;

    color:#66778a !important;

    font-size:12px !important;
    line-height:40px !important;
    font-weight:700 !important;

    box-shadow:none !important;
  }

  #authModal .auth-switch{
    margin:0 !important;

    color:#8794a1 !important;

    font-size:11px !important;
    line-height:18px !important;

    text-align:center !important;
  }

  #authModal .auth-switch .link-btn{
    width:auto !important;
    height:auto !important;

    margin:0 !important;
    padding:0 2px !important;

    display:inline !important;

    border:0 !important;

    background:transparent !important;

    color:#147fd2 !important;

    font-size:11px !important;
    line-height:18px !important;
    font-weight:700 !important;

    box-shadow:none !important;
  }


  /* CLOSE */

  #authModal .modal-close{
    position:absolute !important;

    top:10px !important;
    right:11px !important;

    width:35px !important;
    height:35px !important;

    margin:0 !important;
    padding:0 !important;

    border:0 !important;
    border-radius:50% !important;

    display:grid !important;
    place-items:center !important;

    background:transparent !important;

    color:#35475a !important;

    font-size:25px !important;
    line-height:35px !important;

    box-shadow:none !important;

    z-index:10 !important;
  }



  /* =======================================================
     2. DROPDOWN TÀI KHOẢN DESKTOP
     ======================================================= */

  #desktopAuth .account-menu-shell{
    position:relative !important;

    display:flex !important;
    align-items:center !important;

    gap:8px !important;
  }


  #desktopAuth #accountDropdown{
    position:absolute !important;

    top:48px !important;
    left:0 !important;

    width:292px !important;

    margin:0 !important;
    padding:0 !important;

    overflow:hidden !important;

    border:1px solid #d8e1e9 !important;
    border-radius:10px !important;

    background:#fff !important;

    color:#405267 !important;

    box-shadow:
      0 16px 42px rgba(0,0,0,.25) !important;

    z-index:9999 !important;
  }

  #desktopAuth #accountDropdown.hidden{
    display:none !important;
  }


  /* ACCOUNT HEAD */

  #desktopAuth #accountDropdown
  .account-dropdown-head{
    width:100% !important;

    display:flex !important;
    align-items:center !important;

    gap:10px !important;

    margin:0 !important;
    padding:13px 14px !important;

    background:#f6f9fc !important;

    border:0 !important;
    border-bottom:1px solid #e1e7ed !important;
  }

  #desktopAuth #accountDropdown
  .account-dropdown-avatar{
    width:38px !important;
    height:38px !important;

    min-width:38px !important;

    flex:0 0 38px !important;

    display:grid !important;
    place-items:center !important;

    border-radius:50% !important;

    background:#dff1ff !important;

    color:#1480cc !important;

    font-size:18px !important;
  }

  #desktopAuth #accountDropdown
  .account-dropdown-user{
    min-width:0 !important;

    display:flex !important;
    flex-direction:column !important;

    gap:1px !important;
  }

  #desktopAuth #accountDropdown
  .account-dropdown-user strong{
    display:block !important;

    margin:0 !important;

    overflow:hidden !important;

    color:#33475a !important;

    font-size:13px !important;
    line-height:18px !important;
    font-weight:700 !important;

    white-space:nowrap !important;
    text-overflow:ellipsis !important;
  }

  #desktopAuth #accountDropdown
  .account-dropdown-user span{
    display:block !important;

    color:#8a97a4 !important;

    font-size:10px !important;
    line-height:14px !important;
  }


  /* BALANCE */

  #desktopAuth #accountDropdown
  .account-dropdown-balance{
    width:100% !important;

    margin:0 !important;
    padding:10px 14px !important;

    background:#fff !important;

    border:0 !important;
    border-bottom:1px solid #e6ebf0 !important;
  }

  #desktopAuth #accountDropdown
  .account-dropdown-balance > div{
    width:100% !important;

    display:flex !important;
    align-items:center !important;
    justify-content:space-between !important;

    gap:12px !important;
  }

  #desktopAuth #accountDropdown
  .account-dropdown-balance span{
    color:#718296 !important;

    font-size:11px !important;
  }

  #desktopAuth #accountDropdown
  .account-dropdown-balance strong{
    color:#304b64 !important;

    font-size:13px !important;
    font-weight:800 !important;
  }


  /* SECTIONS */

  #desktopAuth #accountDropdown
  .account-dropdown-section{
    width:100% !important;

    margin:0 !important;
    padding:4px 0 !important;

    display:block !important;

    border:0 !important;
    border-bottom:1px solid #e7ecf1 !important;

    background:#fff !important;
  }

  #desktopAuth #accountDropdown
  .account-dropdown-section:last-child{
    border-bottom:0 !important;
  }


  /* QUAN TRỌNG:
     ép từng button trở thành một hàng,
     loại bỏ hoàn toàn style nút header xanh cũ */

  #desktopAuth #accountDropdown
  button.account-dropdown-row{
    position:static !important;

    width:100% !important;
    min-width:0 !important;

    height:42px !important;
    min-height:42px !important;

    margin:0 !important;
    padding:0 14px !important;

    border:0 !important;
    border-radius:0 !important;

    display:flex !important;
    align-items:center !important;
    justify-content:flex-start !important;

    gap:10px !important;

    background:#fff !important;

    color:#425468 !important;

    font-size:12px !important;
    line-height:42px !important;
    font-weight:400 !important;

    text-align:left !important;

    box-shadow:none !important;

    transform:none !important;
  }

  #desktopAuth #accountDropdown
  button.account-dropdown-row:hover{
    background:#f0f6fb !important;

    color:#147bc7 !important;
  }


  /* ICON */

  #desktopAuth #accountDropdown
  .account-dropdown-icon{
    width:24px !important;
    height:24px !important;

    min-width:24px !important;

    flex:0 0 24px !important;

    margin:0 !important;
    padding:0 !important;

    display:grid !important;
    place-items:center !important;

    border-radius:6px !important;

    font-size:13px !important;
    line-height:24px !important;

    font-style:normal !important;
  }

  #desktopAuth #accountDropdown
  .account-dropdown-icon.money{
    background:#e4f7ef !important;
    color:#159263 !important;
  }

  #desktopAuth #accountDropdown
  .account-dropdown-icon.withdraw{
    background:#e6f1ff !important;
    color:#217fd3 !important;
  }

  #desktopAuth #accountDropdown
  .account-dropdown-icon.profile{
    background:#eaf5ff !important;
  }

  #desktopAuth #accountDropdown
  .account-dropdown-icon.history{
    background:#f0f3f6 !important;
    color:#687d92 !important;
  }

  #desktopAuth #accountDropdown
  .account-dropdown-icon.settings{
    background:#edf2f6 !important;
  }

  #desktopAuth #accountDropdown
  .account-dropdown-icon.support{
    background:#f2efff !important;
  }

  #desktopAuth #accountDropdown
  .account-dropdown-icon.logout{
    background:#fff0f1 !important;
    color:#d94c58 !important;
  }


  #desktopAuth #accountDropdown
  button.account-logout{
    color:#cf4652 !important;
  }

}
