/* =========================================================
   FIX AUTH REGISTER DESKTOP
   - Desktop dùng cùng style với mobile
   ========================================================= */

@media(min-width:761px){

  #authModal{
    position:fixed !important;
    inset:0 !important;

    width:100vw !important;
    height:100vh !important;

    min-width:0 !important;

    display:grid !important;
    place-items:center !important;

    padding:24px !important;

    overflow:auto !important;

    background:
      rgba(0,0,0,.62) !important;

    z-index:99999 !important;
  }


  #authModal.hidden{
    display:none !important;
  }


  #authModal .auth-modal-card{
    position:relative !important;

    width:460px !important;
    max-width:calc(100vw - 48px) !important;

    max-height:calc(100vh - 48px) !important;

    margin:auto !important;

    padding:22px !important;

    overflow-y:auto !important;
    overflow-x:hidden !important;

    border:0 !important;
    border-radius:18px !important;

    background:
      linear-gradient(
        180deg,
        #ffffff 0%,
        #f8fbff 100%
      ) !important;

    box-shadow:
      0 24px 70px
      rgba(0,0,0,.34) !important;
  }


  /* ===============================
     HEADER
     =============================== */

  #authModal .auth-heading{
    display:flex !important;
    align-items:center !important;

    gap:11px !important;

    margin:0 0 18px !important;

    padding-right:28px !important;
  }


  #authModal .auth-heading-icon{
    width:44px !important;
    height:44px !important;

    flex:0 0 44px !important;

    display:grid !important;
    place-items:center !important;

    border-radius:13px !important;

    background:
      linear-gradient(
        145deg,
        #279bf0,
        #0872cf
      ) !important;

    color:#fff !important;

    font-size:21px !important;

    box-shadow:
      0 7px 17px
      rgba(23,126,211,.24) !important;
  }


  #authModal
  .auth-heading.register
  .auth-heading-icon{
    background:
      linear-gradient(
        145deg,
        #ffb82f,
        #f08a16
      ) !important;
  }


  #authModal .auth-heading h2{
    margin:0 !important;

    color:#304257 !important;

    font-size:21px !important;
    line-height:26px !important;
  }


  #authModal .auth-heading p{
    margin:3px 0 0 !important;

    color:#8995a3 !important;

    font-size:11px !important;
  }


  /* ===============================
     REGISTER BANNER
     =============================== */

  #authModal .register-note{
    display:flex !important;
    align-items:center !important;

    gap:9px !important;

    margin-bottom:15px !important;
    padding:10px 11px !important;

    border:
      1px solid
      #ffe0a3 !important;

    border-radius:10px !important;

    background:
      linear-gradient(
        135deg,
        #fff9e9,
        #fff2c7
      ) !important;
  }


  #authModal .register-note > span{
    font-size:20px !important;
  }


  #authModal .register-note div{
    display:grid !important;
    gap:2px !important;
  }


  #authModal .register-note b{
    color:#a76c0c !important;

    font-size:12px !important;
  }


  #authModal .register-note small{
    color:#977c4c !important;

    font-size:10px !important;
  }


  /* ===============================
     FORM
     =============================== */

  #authModal .auth-form{
    display:grid !important;
    gap:12px !important;
  }


  #authModal .auth-field{
    display:grid !important;
    gap:6px !important;
  }


  #authModal .auth-field > span{
    color:#425469 !important;

    font-size:12px !important;
    font-weight:700 !important;
  }


  #authModal .auth-field > span > b{
    color:#ef4d59 !important;
  }


  #authModal .auth-field > span > em{
    margin-left:5px !important;

    color:#9ba6b2 !important;

    font-size:9px !important;
    font-style:normal !important;
    font-weight:400 !important;
  }


  #authModal .auth-input-wrap{
    position:relative !important;

    display:flex !important;
    align-items:center !important;
  }


  #authModal .auth-input-wrap > i{
    position:absolute !important;

    left:12px !important;

    z-index:2 !important;

    width:20px !important;

    color:#7e91a4 !important;

    font-size:13px !important;
    font-style:normal !important;

    text-align:center !important;

    pointer-events:none !important;
  }


  #authModal .auth-input-wrap input{
    width:100% !important;
    height:45px !important;

    margin:0 !important;

    padding:
      0 12px
      0 41px !important;

    border:
      1px solid
      #ccd7e3 !important;

    border-radius:9px !important;

    background:#fff !important;

    color:#35475a !important;

    font-size:13px !important;

    outline:none !important;
  }


  #authModal .auth-input-wrap input:focus{
    border-color:
      #248fe5 !important;

    box-shadow:
      0 0 0 3px
      rgba(36,143,229,.10) !important;
  }


  #authModal .auth-field-help{
    margin-left:2px !important;

    color:#909ba8 !important;

    font-size:9px !important;
    line-height:13px !important;
  }


  /* ===============================
     CAPTCHA
     =============================== */

  #authModal .register-captcha-row{
    display:grid !important;

    grid-template-columns:
      minmax(0,1fr)
      105px !important;

    gap:8px !important;
  }


  #authModal .register-captcha-code{
    width:105px !important;
    height:45px !important;

    margin:0 !important;
    padding:0 !important;

    border:
      1px solid
      #bdcad7 !important;

    border-radius:9px !important;

    background:
      repeating-linear-gradient(
        -15deg,
        #eef4f8,
        #eef4f8 7px,
        #dae6ef 8px,
        #eef4f8 10px
      ) !important;

    color:#334b62 !important;

    font-size:21px !important;
    font-weight:900 !important;

    letter-spacing:5px !important;

    text-shadow:
      1px 1px 0 #fff !important;
  }


  /* ===============================
     AGREEMENT
     =============================== */

  #authModal .register-agreement{
    display:flex !important;
    align-items:flex-start !important;

    gap:8px !important;

    padding:9px 10px !important;

    border-radius:8px !important;

    background:#f1f6fa !important;

    color:#64768a !important;

    font-size:10px !important;
    line-height:15px !important;
  }


  #authModal .register-agreement input{
    width:15px !important;
    height:15px !important;

    flex:0 0 15px !important;

    margin:1px 0 0 !important;
  }


  /* ===============================
     BUTTONS
     =============================== */

  #authModal .auth-main-btn{
    width:100% !important;
    min-height:45px !important;

    margin-top:2px !important;

    border:0 !important;
    border-radius:9px !important;

    background:
      linear-gradient(
        135deg,
        #168ff0,
        #066bce
      ) !important;

    color:#fff !important;

    font-size:14px !important;
    font-weight:800 !important;

    box-shadow:
      0 7px 17px
      rgba(17,119,215,.20) !important;
  }


  #authModal #registerPane .auth-main-btn{
    background:
      linear-gradient(
        135deg,
        #23a7ef,
        #087bc9
      ) !important;
  }


  #authModal .auth-reset-btn{
    width:100% !important;
    min-height:40px !important;

    margin:0 !important;

    border:
      1px solid
      #d9e2eb !important;

    border-radius:9px !important;

    background:#fff !important;

    color:#64758a !important;

    font-weight:700 !important;
  }


  #authModal .auth-switch{
    margin:2px 0 0 !important;

    color:#8793a0 !important;

    font-size:11px !important;

    text-align:center !important;
  }


  #authModal .auth-switch .link-btn{
    width:auto !important;
    height:auto !important;

    padding:0 !important;

    background:transparent !important;

    color:#1684da !important;

    font-weight:700 !important;
  }


  /* ===============================
     CLOSE BUTTON
     =============================== */

  #authModal .modal-close{
    position:absolute !important;

    top:10px !important;
    right:12px !important;

    width:34px !important;
    height:34px !important;

    padding:0 !important;

    display:grid !important;
    place-items:center !important;

    border:0 !important;

    background:transparent !important;

    color:#33475b !important;

    font-size:25px !important;

    z-index:5 !important;
  }

}
