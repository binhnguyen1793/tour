function refreshCaptchaCode(){

  captchaCode=
    generateCaptchaCode();


  document
    .querySelectorAll(
      '.captcha-box'
    )
    .forEach(
      captcha=>{

        captcha.textContent=
          captchaCode;

      }
    );

}




