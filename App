el('registerCaptchaCode')
  ?.addEventListener(
    'click',
    refreshCaptchaCode
  );


el('resetRegister')
  ?.addEventListener(
    'click',
    ()=>{

      [
        'registerReferral',
        'registerUser',
        'registerPass',
        'registerPassConfirm',
        'registerFullname',
        'registerCaptchaInput'
      ]
        .forEach(
          id=>{

            if(el(id)){
              el(id).value='';
            }

          }
        );


      if(
        el('registerAgree')
      ){
        el('registerAgree').checked=
          false;
      }


      refreshCaptchaCode();

    }
  );

